{
  "id": "neodex.music",
  "name": "NeoMusic",
  "version": "1.2.2",
  "author": "NDesumeur",
  "description": "NeoMusic sur téléphone : les mêmes thèmes, la même platine, les mêmes playlists que sur PC (synchronisées), recherche et liens YouTube, favoris, statistiques, 33 succès et niveaux, mode sommeil, widget. La musique continue écran éteint, avec lecture / pause et suivant dans la notification.",
  "icon": "icon.png",
  "entry": "index.js",
  "view": "music",
  "neobase": ">=4.1.0",
  "neodex": ">=3.2.0",
  "type": "app",
  "category": "Musique",
  "syncMode": "fusion",
  "syncInfo": "Seuls les playlists, le niveau et les succès voyagent. Réglages, morceau en cours, file d'attente et historique d'écoute restent sur chaque appareil.",
  "mobile": true,
  "compatibility": [
    "android"
  ],
  "system": false,
  "dependencies": {},
  "sync": {
    "library": { "share": ["playlists", "stats", "achievements", "-stats.history"],
      "auto": [
        "session",
        "stats.*",
        "achievements"
      ],
      "union": [
        "stats.history"
      ]
    }
  },
  "sdk": "2.1.0",
  "permissions": [
    "storage",
    "music",
    "network:i.ytimg.com",
    "camera",
    "widget"
  ],
  "commands": [
    {
      "id": "toggle",
      "title": "Lecture / pause",
      "background": true
    },
    {
      "id": "next",
      "title": "Morceau suivant",
      "background": true
    },
    {
      "id": "prev",
      "title": "Morceau précédent",
      "background": true
    },
    {
      "id": "fav",
      "title": "Ajouter ou retirer des favoris",
      "background": true
    },
    {
      "id": "volup",
      "title": "Monter le volume",
      "background": true
    },
    {
      "id": "voldown",
      "title": "Baisser le volume",
      "background": true
    }
  ],
  "widget": "widget.js"
}
